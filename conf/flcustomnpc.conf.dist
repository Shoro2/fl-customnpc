[worldserver]

########################################
# My module configuration
########################################
#
#    flcn.Enable
#        Description: Enable my module and print "Hello World" message at server start
#        Default:     0 - Disabled
#                     1 - Enabled
#

flcn.Enable = 1


## Level Up NPC

flcn.levelup.Enable = 1

## Gurubashi Pvp Event

flcn.pvpevent.Enable = 1
flcn.gurumaster.Enable = 1
flcn.portonrelease.Enable = 1